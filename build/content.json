  "stack": "<dl class=\"stack-list stagger\">\n              <div class=\"stack-row\">\n                <dt class=\"stack-label mono\">PROGRAMMING LANGUAGES</dt>\n                <dd class=\"stack-items\">\n                  <span>JavaScript</span>\n                  <span>TypeScript</span>\n                  <span>Python</span>\n                  <span>Java</span>\n                  <span>PHP</span>\n                  <span>C++</span>\n                </dd>\n              </div>\n              <div class=\"stack-row\">\n                <dt class=\"stack-label mono\">FRONTEND</dt>\n                <dd class=\"stack-items\">\n                  <span>HTML5</span>\n                  <span>CSS3</span>\n                  <span>React</span>\n                  <span>Next.js</span>\n                  <span>Tailwind CSS</span>\n                </dd>\n              </div>\n              <div class=\"stack-row\">\n                <dt class=\"stack-label mono\">BACKEND</dt>\n                <dd class=\"stack-items\">\n                  <span>Node.js</span>\n                  <span>Laravel</span>\n                </dd>\n              </div>\n              <div class=\"stack-row\">\n                <dt class=\"stack-label mono\">DATABASE</dt>\n                <dd class=\"stack-items\">\n                  <span>MySQL</span>\n                  <span>PostgreSQL</span>\n                  <span>Firebase</span>\n                </dd>\n              </div>\n              <div class=\"stack-row\">\n                <dt class=\"stack-label mono\">TOOLS &amp; ENVIRONMENT</dt>\n                <dd class=\"stack-items\">\n                  <span>Git</span>\n                  <span>GitHub</span>\n                  <span>VS Code</span>\n                  <span>Vercel</span>\n                  <span>XAMPP</span>\n                  <span>Figma</span>\n                </dd>\n              </div>\n              <div class=\"stack-row\">\n                <dt class=\"stack-label mono\">AI &amp; MACHI