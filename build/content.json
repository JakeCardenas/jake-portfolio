  "internship": "<li class=\"tl-item\">\n              <div class=\"tl-year mono\">2026</div>\n              <div class=\"tl-card\">\n                <h3 class=\"entry-title\">\n                  Full Stack &amp; Agentic AI Developer Intern\n                </h3>\n                <div class=\"tl-org\">\n                  Employability Advantage\n                  <span class=\"meta-sep\">×</span> AusBiz Consulting Pty Ltd\n                </div>\n                <div class=\"entry-meta mono\">\n                  February 17 – May 5, 2026<span class=\"meta-sep\">·</span>10-week\n                  industry engagement\n                </div>\n                <p class=\"entry-body\">\n                  Successfully completed a 10-week industry project internship\n                  focused on full-stack development and agentic AI, with\n                  hands-on experience building projects and guidance from\n                  experts at AusBiz Consulting Pty Ltd.\n                </p>\n                <div class=\"chip-row\">\n                  <span class=\"chip mono\">Full-Stack Development</span>\n                  <span class=\"chip mono\">Agentic AI</span>\n                  <span class=\"chip mono\">Code Review</span>\n                </div>\n              </div>\n            </li>",
  "experience": "<li class=\"tl-item\">\n              <div class=\"tl-year mono\">2025</div>\n              <div class=\"tl-card\">\n                <h3 class=\"entry-title\">Midyear Interactive Youth Forum</h3>\n                <div class=\"tl-org\">\n                  Philippine Association of Practitioners of Student Affairs and\n                  Services\n                </div>\n                <div class=\"entry-meta mono\">\n                  September 17–19, 2025<span class=\"meta-sep\">·</span>Summit\n                  Galleria Cebu, Cebu City\n                </div>\n                <p class=\"entry-body\">\n                  A national youth leadership forum that brought together\n                  student officers and leaders from schools across the\n                  Philippines to learn about leadership, good governance,\n                  accountability, and youth participation.\n                </p>\n                <div class=\"chip-row\">\n                  <span class=\"chip mono\">Leadership</span>\n                  <span class=\"chip mono\">Good Governance</span>\n                  <span class=\"chip mono\">Youth Development</span>\n                </div>\n              </div>\n            </li>",
  "projects": [
    "<article class=\"project-card\">\n            <div class=\"entry-head project-head\">\n              <div>\n                <h3 class=\"entry-title\">Digital Twin Platform</h3>\n                <div class=\"entry-meta mono\">\n                  FULL-STACK<span class=\"meta-sep\">·</span>INTERACTIVE\n                  PORTFOLIO<span class=\"meta-sep\">·</span>AI-POWERED CHAT\n                </div>\n              </div>\n            </div>\n\n            <p class=\"entry-body\">\n              A full-stack platform with an interactive portfolio and an\n              AI-powered chat.\n            </p>\n\n            <div class=\"card-label mono\">TECH STACK</div>\n            <div class=\"tech-row\">\n              <span class=\"tech mono\"\n                ><i class=\"devicon-react-original\"></i>React.js</span\n              >\n              <span class=\"tech mono\"\n                ><i class=\"devicon-nextjs-plain\"></i>Next.js</span\n              >\n              <span class=\"tech mono\"\n                ><i class=\"devicon-nodejs-plain\"></i>Node.js</span\n              >\n              <span class=\"tech mono\"\n                ><span class=\"icon-generic\"></span>AI</span\n              >\n            </div>\n\n            <a\n              href=\"https://grouptwodigitaltwin.vercel.app/\"\n              target=\"_blank\"\n              rel=\"noopener\"\n              class=\"link-out mono\"\n            >\n              VIEW LIVE SITE <span aria-hidden=\"true\">↗</span>\n            </a>\n\n            <div class=\"project-carousel\" data-carousel>\n              <div class=\"carousel-stack\">\n                <div class=\"carousel-slide active\" data-slide=\"0\">\n                  <img\n                    src=\"./images/projects/digital-twin-1.jpg\"\n                    alt=\"Digital Twin Platform AI chat answering a question\"\n                    loading=\"lazy\"\n                  />\n                </div>\n                <div class=\"carousel-slide\" data-slide=\"1\">\n                  <img\n                    src=\"./images/projects/digital-twin-2.jpg\"\n                    alt=\"Digital Twin Platform portfolio site\"\n                    loading=\"lazy\"\n                  />\n                </div>\n              </div>\n              <div class=\"carousel-dots\">\n                <button\n                  class=\"carousel-dot active\"\n                  data-dot=\"0\"\n                  aria-label=\"Screenshot 1\"\n                ></button>\n                <button\n                  class=\"carousel-dot\"\n                  data-dot=\"1\"\n                  aria-label=\"Screenshot 2\"\n                ></button>\n              </div>\n            </div>\n          </article>",
    "<article class=\"project-card\">\n            <div class=\"entry-head project-head\">\n              <div>\n                <h3 class=\"entry-title\">Reps — Workout Tracker</h3>\n                <div class=\"entry-meta mono\">\n                  WEB APP<span class=\"meta-sep\">·</span>OFFLINE-FIRST\n                  PWA<span class=\"meta-sep\">·</span>NODE BACKEND\n                </div>\n              </div>\n            </div>\n\n            <p class=\"entry-body\">\n              A workout tracker for planning exercises, customizing sets and\n              reps, and following your gym progress. It has a library of 99\n              movements, a weekly split planner, a set-by-set runner with a rest\n              timer, and it installs as an offline PWA.\n            </p>\n\n            <div class=\"card-label mono\">TECH STACK</div>\n            <div class=\"tech-row\">\n              <span class=\"tech mono\"\n                ><i class=\"devicon-javascript-plain\"></i\n                >JavaScript</span\n              >\n              <span class=\"tech mono\"\n                ><i class=\"devicon-nodejs-plain\"></i>Node.js</span\n              >\n              <span class=\"tech mono\"\n                ><i class=\"devicon-sqlite-plain\"></i>SQLite</span\n              >\n              <span class=\"tech mono\"><span class=\"icon-generic\"></span>PWA</span>\n            </div>\n\n            <a\n              href=\"https://reps-one-psi.vercel.app/\"\n              target=\"_blank\"\n              rel=\"noopener\"\n              class=\"link-out mono\"\n            >\n              VIEW LIVE SITE <span aria-hidden=\"true\">↗</span>\n            </a>\n\n            <div class=\"project-carousel\" data-carousel>\n              <div class=\"carousel-stack\">\n                <div class=\"carousel-slide active\" data-slide=\"0\">\n                  <img\n                    src=\"./images/projects/reps-1.jpg\"\n                    alt=\"Reps workout builder with a Push session loaded\"\n                    loading=\"lazy\"\n                  />\n                </div>\n                <div class=\"carousel-slide\" data-slide=\"1\">\n                  <img\n                    src=\"./images/projects/reps-2.jpg\"\n                    alt=\"Reps exercise library of 99 movements\"\n                    loading=\"lazy\"\n                  />\n                </div>\n              </div>\n              <div class=\"carousel-dots\">\n                <button\n                  class=\"carousel-dot active\"\n                  data-dot=\"0\"\n                  aria-label=\"Screenshot 1\"\n                ></button>\n                <button\n                  class=\"carousel-dot\"\n                  data-dot=\"1\"\n                  aria-label=\"Screenshot 2\"\n                ></button>\n              </div>\n            </div>\n          </article>",
    "<article class=\"project-card\">\n            <div class=\"entry-head project-head\">\n              <div>\n                <h3 class=\"entry-title\">CardenasDev — Key Visual</h3>\n                <div class=\"entry-meta mono\">\n                  GRAPHIC DESIGN<span class=\"meta-sep\">·</span>PORTFOLIO KEY\n                  VISUAL<span class=\"meta-sep\">·</span>PHOTOSHOP\n                </div>\n              </div>\n            </div>\n\n            <p class=\"entry-body\">\n              A key visual for my portfolio, inspired by The Creation of Adam,\n              representing the connection between ideas, technology, and my\n              journey exploring AI and full-stack development.\n            </p>\n\n            <div class=\"card-label mono\">MADE WITH</div>\n            <div class=\"tech-row\">\n              <span class=\"tech mono\"\n                ><i class=\"devicon-photoshop-plain\"></i>Adobe\n                Photoshop</span\n              >\n            </div>\n\n            <div class=\"project-carousel\" data-carousel>\n              <div class=\"carousel-stack\">\n                <div class=\"carousel-slide active\" data-slide=\"0\">\n                  <img\n                    src=\"./images/projects/cardenasdev-1.jpg\"\n                    alt=\"CardenasDev key visual: two halftone hands reaching toward a JSON profile window\"\n                    loading=\"lazy\"\n                  />\n                </div>\n              </div>\n            </div>\n          </article>"
